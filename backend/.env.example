# Production requires a random JWT_SECRET of at least 32 characters, explicit
# trusted HTTPS CORS_ORIGIN values, a trusted HTTPS OTP_DELIVERY_URL, and three
# distinct DEFAULT_*_PASSWORD values of 12 to 72 UTF-8 bytes before seeding.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/college_portal.sqlite
CORS_ORIGIN=*
OTP_EXPIRY_MINUTES=10
DEFAULT_STUDENT_PASSWORD=student123
DEFAULT_TEACHER_PASSWORD=teacher123
DEFAULT_ADMIN_PASSWORD=admin123
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
