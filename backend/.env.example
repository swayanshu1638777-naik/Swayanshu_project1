# Production requires a random JWT_SECRET of at least 32 characters, explicit
# trusted HTTPS CORS_ORIGIN values, configured email OTP delivery, and three
# distinct DEFAULT_*_PASSWORD values of 12 to 72 UTF-8 bytes.
# New passwords are limited to 72 bytes; legacy account passwords remain valid.
PORT=5000
FRONTEND_PORT=5501
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/college_portal.sqlite
DATABASE_BACKUP_DIR=./data/backups
CORS_ORIGIN=*
# OTP lifetime must be between 1 and 60 minutes.
OTP_EXPIRY_MINUTES=10
DEFAULT_STUDENT_PASSWORD=student123
DEFAULT_TEACHER_PASSWORD=teacher123
DEFAULT_ADMIN_PASSWORD=admin123
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# For Brevo SMTP, set OTP_DELIVERY_PROVIDER=brevo-smtp,
# BREVO_SMTP_USER, BREVO_SMTP_KEY, and OTP_FROM_EMAIL.
