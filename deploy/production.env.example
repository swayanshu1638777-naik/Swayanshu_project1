NODE_ENV=production
DOMAIN=portal.example.com
PORT=5000
TRUST_PROXY=1
DATABASE_PATH=/app/data/college_portal.sqlite
DATABASE_BACKUP_DIR=/app/backups

JWT_SECRET=CHANGE_ME_generate_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://portal.example.com

INITIAL_ADMIN_USERNAME=CHANGE_ME_initial_admin_username
INITIAL_ADMIN_EMAIL=CHANGE_ME_initial_admin@college.edu
INITIAL_ADMIN_NAME=CHANGE_ME_initial_admin_name
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password_12_to_72_bytes
DEFAULT_TEACHER_PASSWORD=CHANGE_ME_teacher_password_12_to_72_bytes
DEFAULT_STUDENT_PASSWORD=CHANGE_ME_student_password_12_to_72_bytes

# Compose uses Resend for production email OTP. The backend's HTTPS webhook
# adapter remains available to non-Compose integrations.
OTP_EXPIRY_MINUTES=10
OTP_FROM_EMAIL=CHANGE_ME_sender@college.edu
RESEND_API_KEY=CHANGE_ME_resend_api_key

# Backblaze B2 S3-compatible endpoint example; choose the endpoint for your bucket.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=CHANGE_ME_private_backup_bucket
S3_ACCESS_KEY_ID=CHANGE_ME_restricted_backup_key_id
S3_SECRET_ACCESS_KEY=CHANGE_ME_restricted_backup_application_key
S3_PREFIX=college-portal
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
